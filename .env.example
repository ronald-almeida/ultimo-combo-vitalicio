BLACKCAT_API_KEY=
# Gere um segredo aleatório de pelo menos 32 caracteres.
CHECKOUT_SECRET=
PORT=3000
# URL pública da hospedagem, sem barra final.
APP_ORIGIN=http://localhost:3000
# Opcional: outros endereços autorizados, separados por vírgula (por exemplo, domínio com www).
APP_ORIGINS=
# Diretório persistente: mantém tentativas para impedir cobranças duplicadas.
DATA_DIR=./data
